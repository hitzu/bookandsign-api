meta {
  name: get public event theme
  type: http
  seq: 2
}

get {
  url: {{base_url}}/events/{{event_token}}/theme
  body: none
  auth: inherit
}

headers {
  ~Authorization: Bearer {{token}}
}

vars:pre-request {
  event_token: 4aabc31e-7382-4ba6-9f5d-fe47d0dcf79a
}

settings {
  encodeUrl: true
  timeout: 0
}
