meta {
  name: create event
  type: http
  seq: 1
}

post {
  url: {{base_url}}/events
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "contractId": {{contract_id}},
    "key": "20",
    "eventTypeId": 1,
    "serviceTypeId": 1,
    "honoreesNames": "Sinai y Eduardo",
    "albumPhrase": "Nuestro para siempre comienza hoy",
    "venueName": "Salón ejemplo",
    "serviceLocationUrl": "https://maps.app.goo.gl/example",
    "serviceStartsAt": "2026-06-15T18:00:00.000Z",
    "serviceEndsAt": "2026-06-16T02:00:00.000Z",
    "delegateName": "Contacto principal",
    "photoCount": 3,
    "eventThemeId": 1,
    "printTemplates": [
      {
        "icon": "rings",
        "type": "polaroid",
        "border": "led",
        "template": "polaroid_rc_2"
      },
      {
        "type": "keychain",
        "template": "keychain_rc_2"
      },
      {
        "icon": "rings",
        "type": "polaroid",
        "border": "led",
        "template": "polaroid_rc_2"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
