meta {
  name: get event by token
  type: http
  seq: 2
}

get {
  url: {{base_url}}/events/{{event_token}}
  body: none
  auth: inherit
}

headers {
  ~Authorization: Bearer {{token}}
}

vars:pre-request {
  event_token: 0f3c8b47-b0b6-4f56-9d0b-46977e787384
}

settings {
  encodeUrl: true
  timeout: 0
}
