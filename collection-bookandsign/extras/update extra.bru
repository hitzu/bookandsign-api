meta {
  name: update extra
  type: http
  seq: 6
}

patch {
  url: {{base_url}}/extras/{{extra_id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "brandId": {{brand_id}},
    "name": "Espejo recepción - salón premium",
    "description": "Incluye montaje y presencia durante el evento",
    "price": 650,
    "status": "inactive"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
