meta {
  name: list photos by event
  type: http
  seq: 1
}

get {
  url: {{base_url}}/photos/event/{{event_token}}?limit={{limit}}
  body: none
  auth: inherit
}

params:query {
  limit: {{limit}}
}

headers {
  ~Authorization: Bearer {{token}}
}

vars:pre-request {
  event_token: 2f8e2465-24d8-4e07-b671-bdfc0b3dd39e
  limit: 99
  cursor: eyJjcmVhdGVkQXQiOiIyMDI2LTAyLTI0VDAyOjA2OjI5LjE3MloiLCJpZCI6Nzl9
}

settings {
  encodeUrl: true
  timeout: 0
}
