meta {
  name: confirm photo
  type: http
  seq: 9
}

post {
  url: {{base_url}}/sessions/photos/confirm
  body: json
  auth: none
}

body:json {
  {
    "photoId": {{session_photo_id}}
  }
}

script:post-response {
  if (!res.body?.photos?.length) {
    throw new Error('Expected confirmed session response with at least one photo');
  }

  const missingMinimizedUrl = res.body.photos.some((photo) => !photo.minimizedUrl);
  if (missingMinimizedUrl) {
    throw new Error('Expected all confirmed photos to include minimizedUrl');
  }
}

vars:pre-request {
  session_photo_id: 95
}

settings {
  encodeUrl: true
  timeout: 0
}
