meta {
  name: 02 - set package tiers (bulk)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/promotions/{{promotion_id}}/packages/bulk
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "packages": [
      {
        "packageId": {{package_basico_id}},
        "tiers": [
          { "order": 1, "discountPercentage": 100 },
          { "order": 2, "discountPercentage": 50 }
        ]
      },
      {
        "packageId": {{package_plus_id}},
        "tiers": [
          { "order": 1, "discountPercentage": 100 },
          { "order": 2, "discountPercentage": 100 }
        ]
      }
    ]
  }
}

vars:pre-request {
  package_basico_id: 25
  package_plus_id: 26
  promotion_id: 6
}

settings {
  encodeUrl: true
  timeout: 0
}
