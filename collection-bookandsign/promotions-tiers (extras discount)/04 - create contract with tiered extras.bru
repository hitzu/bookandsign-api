meta {
  name: 04 - create contract with tiered extras
  type: http
  seq: 4
}

post {
  url: {{base_url}}/contracts
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "userId": {{user_id}},
    "slotId": {{slot_id}},
    "brandId": {{brand_id}},
    "sku": "tiers-demo-001",
    "clientName": "Cliente Inauguración",
    "clientPhone": "2201752767",
    "clientEmail": "tiers-demo@example.com",
    "packages": [
      {
        "packageId": {{package_basico_id}},
        "quantity": 1,
        "clientRef": "pkg-1"
      }
    ],
    "extras": [
      {
        "extraId": {{extra_id}},
        "quantity": 1,
        "packageClientRef": "pkg-1"
      },
      {
        "extraId": {{extra_id}},
        "quantity": 1,
        "packageClientRef": "pkg-1"
      },
      {
        "extraId": {{extra_id}},
        "quantity": 1,
        "packageClientRef": "pkg-1"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
