meta {
  name: 01 - create promotion
  type: http
  seq: 1
}

post {
  url: {{base_url}}/promotions
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "brandId": {{brand_id}},
    "name": "Inauguración Lusso",
    "type": "percentage",
    "value": 10,
    "status": "active",
    "validFrom": null,
    "validUntil": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
