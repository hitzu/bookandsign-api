meta {
  name: dashboard
  type: http
  seq: 8
}

get {
  url: {{base_url}}/event-analytics/db69c995-b30b-40b4-85e7-c01a79eff1a1/dashboard
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "action": "session_completed",
    "eventToken": "{{event_token}}",
    "sessionId": "{{event_token}}",
    "source": "photobooth",
    "photoCount": 4,
    "personCount": 2,
    "metadata": {
      "durationMs": 120000
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
