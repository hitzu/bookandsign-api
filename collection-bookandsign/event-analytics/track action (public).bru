meta {
  name: track action (public)
  type: http
  seq: 1
}

post {
  url: {{base_url}}/event-analytics/track
  body: json
  auth: none
}

body:json {
  {
    "action": "photo_view",
    "eventToken": "{{event_token}}",
    "sessionId": "{{event_token}}",
    "source": "photobooth",
    "surface": "session-carousel",
    "itemType": "photo",
    "variant": "portrait",
    "itemIndex": 2,
    "itemCount": 12,
    "photoCount": 8,
    "personCount": 3,
    "metadata": {
      "referrer": "share-link",
      "locale": "es-MX"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
