meta {
  name: track action (public) start session
  type: http
  seq: 6
}

post {
  url: {{base_url}}/event-analytics/track
  body: json
  auth: none
}

body:json {
  {
    "action": "session_started",
   "eventToken": "{{event_token}}",
    "sessionId": "{{event_token}}",
    "source": "photobooth",
    "surface": "booth",
    "photoCount": 0,
    "personCount": 1,
    "metadata": {
      "boothId": "booth-01"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
