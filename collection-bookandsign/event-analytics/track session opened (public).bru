meta {
  name: track session opened (public)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/event-analytics/track
  body: json
  auth: none
}

body:json {
  {
    "action": "session_opened",
    "source": "gallery",
    "eventToken": "{{event_token}}",
    "sessionId": "{{session_token}}"
  }
}

vars:pre-request {
  session_token: c1d2e3f4-0000-4000-8000-cabbccddeeff
}

settings {
  encodeUrl: true
  timeout: 0
}
