meta {
  name: track action (public) finish session
  type: http
  seq: 7
}

post {
  url: {{base_url}}/event-analytics/track
  body: json
  auth: none
}

body:json {
  {
    "action": "session_completed",
    "eventToken": "{{event_token}}",
    "sessionId": "{{event_token}}",
    "source": "photobooth"
    
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
