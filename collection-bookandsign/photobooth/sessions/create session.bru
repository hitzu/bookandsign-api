meta {
  name: create session
  type: http
  seq: 10
}

post {
  url: {{base_url}}/sessions
  body: json
  auth: none
}

body:json {
  {
    "sessionToken": "{{session_token}}",
    "eventToken": "{{event_token}}"
  }
}

vars:pre-request {
  session_token: c3d2e3f4-0000-4000-8000-cabbccddeeff
  event_token: 45ac4c18-9311-42e5-ba09-02b76c6e44c0
}

settings {
  encodeUrl: true
  timeout: 0
}
