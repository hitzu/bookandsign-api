meta {
  name: create session
  type: http
  seq: 10
}

post {
  url: {{base_url}}/sessions
  body: json
  auth: none
}

body:json {
  {
    "sessionToken": "{{session_token}}",
    "eventToken": "{{event_token}}"
  }
}

vars:pre-request {
  session_token: c9d2e3f4-3000-4000-8000-cabbccddeeff
  event_token: 986792a2-01e9-4690-9f8a-c35900aae12f
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Este endpoint solo esta en caso de que necesitemos crear una sesion, pero la sesion se crea en automatico con el primer presigned url cargado
}
