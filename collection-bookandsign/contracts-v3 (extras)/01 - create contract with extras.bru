meta {
  name: 01 - create contract with extras
  type: http
  seq: 1
}

post {
  url: {{base_url}}/contracts
  body: json
  auth: inherit
}

headers {
  authorization: Bearer {{token}}
}

body:json {
  {
    "userId": {{user_id}},
    "slotId": {{slot_id}},
    "brandId": {{brand_id}},
    "sku": "extras06Jun26v3",
    "clientName": "Cliente extras v3",
    "clientPhone": "2201752767",
    "clientEmail": "extras-v3@example.com",
    "subtotal": 3000,
    "discountTotal": 0,
    "total": 3000,
    "packages": [
      {
        "packageId": {{package_id}},
        "quantity": 1
      }
    ],
    "extras": [
      {
        "extraId": 2,
        "quantity": 1,
        "basePriceSnapshot": 500
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
